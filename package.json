{
  "name": "omp-ui",
  "private": true,
  "license": "MIT",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @omp-ui/desktop",
    "build": "npm run build --workspace @omp-ui/desktop",
    "package": "npm run package --workspace @omp-ui/desktop",
    "stamp": "npm version patch --no-git-tag-version --workspace @omp-ui/desktop",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
