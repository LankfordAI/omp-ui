{
  "name": "omp-ui",
  "private": true,
  "license": "MIT",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @omp-ui/desktop",
    "dev:headless": "npm run dev:headless --workspace @omp-ui/desktop",
    "build": "npm run build --workspace @omp-ui/desktop",
    "package": "npm run package --workspace @omp-ui/desktop",
    "stamp": "npm version patch --no-git-tag-version --workspace @omp-ui/desktop",
    "notes": "node scripts/release-notes.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:live": "npm run test:live --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
