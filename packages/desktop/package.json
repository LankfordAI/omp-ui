{
  "name": "@omp-ui/desktop",
  "version": "0.8.5",
  "private": true,
  "description": "Desktop GUI for the omp coding agent",
  "author": "Austin Lankford <austin@austinlankford.com>",
  "license": "MIT",
  "homepage": "https://github.com/LankfordAI/omp-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/LankfordAI/omp-ui.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "npm run themes:generate && install-electron --no",
    "dev": "electron-vite dev --watch",
    "build": "npm run themes:generate && electron-vite build && npm run build:web",
    "build:web": "vite build --config vite.web.config.ts",
    "package": "npm run package:linux",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win --x64",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "icon": "node scripts/render-icon.mjs",
    "themes:generate": "node scripts/generate-theme-css.mjs",
    "themes:check": "node scripts/generate-theme-css.mjs --check",
    "test": "npm run themes:check && vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@omp-ui/core": "*",
    "@omp-ui/server": "*",
    "@shikijs/langs": "^4.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.4",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
