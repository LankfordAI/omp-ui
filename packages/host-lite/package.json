{
  "name": "@omp-ui/host-lite",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./credentials": "./src/credentials/index.ts",
    "./fleet-legs": "./src/fleet-legs/index.ts"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "serve": "tsx src/cli.ts serve",
    "bundle": "node scripts/bundle-session.mjs",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:node-pty --external:node:* --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "sea": "node scripts/package-sea.mjs",
    "proof:join": "node proofs/join-two-instances.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "omp-ui-lite": "./dist/cli.js"
  },
  "dependencies": {
    "@omp-ui/core": "*",
    "@omp-ui/server": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
